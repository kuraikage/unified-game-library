{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UGLy",
  "version": "1.0.0",
  "identifier": "com.ugly.library",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix client",
    "beforeBuildCommand": "npm run build --prefix client"
  },
  "app": {
    "windows": [
      {
        "title": "UGLy — Unified Game Library",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://cdn.cloudflare.steamstatic.com https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com https://images.igdb.com https://cdn1.epicgames.com https://cdn2.unrealengine.com",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://cdn.cloudflare.steamstatic.com https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com https://images.igdb.com https://cdn1.epicgames.com https://cdn2.unrealengine.com",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "UGLy",
    "externalBin": ["binaries/ugly-mcp"],
    "shortDescription": "All your games. One place.",
    "longDescription": "UGLy (Unified Game Library) brings your Steam and Epic Games libraries together in one searchable place, enriched with genres, tags and artwork from IGDB.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
