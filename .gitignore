# ---- dependencies & build output ----
node_modules/
dist/
dist-ssr/
# Cargo workspace output now sits at the repo root
target/
src-tauri/target/

# Generated by the Tauri CLI at build time
src-tauri/gen/schemas/

# ---- logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- local config & secrets ----
# Credentials are kept in the OS keychain, not in files, but never let a stray
# .env or config dump reach the repo.
.env
.env.*
!.env.example
config.json
secrets.json

# ---- personal data ----
# Your library, metadata cache and any exports are private to your machine.
*.db
*.db-shm
*.db-wal
ugly-library-*.csv
_legacy-node-backup/

# ---- local tooling ----
.claude/
.vscode/
.idea/
*.swp

# ---- OS noise ----
.DS_Store
Thumbs.db
desktop.ini
